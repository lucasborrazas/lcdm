# Usada solo por `prisma migrate dev` para generar migraciones nuevas contra
# un archivo local — la app en sí ya no lee esta variable en runtime.
DATABASE_URL="file:./prisma/dev.db"

# La app (local y en Vercel) se conecta a la base real en Turso con estas dos.
# Sacalas con: `turso db show <nombre> --url` y `turso db tokens create <nombre>`
TURSO_DATABASE_URL="libsql://<tu-db>.turso.io"
TURSO_AUTH_TOKEN="ey..."
