generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Producto {
  id          String    @id @default(cuid())
  temporada   Temporada
  genero      Genero
  nombre      String
  talle       String
  costoActual Int?
  precioVenta Int       @default(0)
  stockMinimo Int?
  archivado   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  stock            Stock?
  movimientos      MovimientoStock[]
  pedidos          Pedido[]
  historialPrecios HistorialPrecios[]

  @@unique([temporada, genero, nombre, talle])
}

model Stock {
  id           String   @id @default(cuid())
  productoId   String   @unique
  stockInicial Int      @default(0)
  alertaMinimo Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  producto Producto @relation(fields: [productoId], references: [id])
}

// stockActual se calcula: stockInicial + sum(INGRESO) - sum(EGRESO) de MovimientoStock con stockProcesado=true
// mas egresos de Pedido con stockDescontado=true

model MovimientoStock {
  id                  String         @id @default(cuid())
  fecha               DateTime
  periodo             String
  productoId          String
  temporada           Temporada
  genero              Genero
  productoNombre      String
  talle               String
  tipo                TipoMovimiento
  cantidad            Int
  motivo              String
  notas               String?
  compraId            String?
  costoUnitarioCompra Int?
  totalLineaCompra    Int?
  subtotalLinea       Int?
  envioTotalCompra    Int?
  costoEnvioUnitario  Int?
  costoUnitarioReal   Int?
  stockProcesado      Boolean        @default(false)
  createdAt           DateTime       @default(now())

  producto Producto @relation(fields: [productoId], references: [id])
}

model MovimientoEliminado {
  id                   String         @id @default(cuid())
  movimientoIdOriginal String
  fecha                DateTime
  periodo              String
  productoId           String
  temporada            Temporada
  genero               Genero
  productoNombre       String
  talle                String
  tipo                 TipoMovimiento
  cantidad             Int
  motivo               String
  notas                String?
  compraId             String?
  costoUnitarioCompra  Int?
  totalLineaCompra     Int?
  subtotalLinea        Int?
  envioTotalCompra     Int?
  costoEnvioUnitario   Int?
  costoUnitarioReal    Int?
  eliminadoEn          DateTime       @default(now())
}

model Pedido {
  id              String       @id @default(cuid())
  fecha           DateTime
  periodo         String
  cliente         String
  productoId      String
  temporada       Temporada
  genero          Genero
  productoNombre  String
  talle           String
  cantidad        Int
  costoUnitario   Int
  costoTotal      Int
  metodoPago      MetodoPago
  precioUnitario  Int
  precioTotal     Int
  ganancia        Int
  sena            Int          @default(0)
  saldoRestante   Int
  estadoPedido    EstadoPedido @default(POR_PEDIR)
  estadoPago      EstadoPago   @default(PENDIENTE)
  stockDescontado Boolean      @default(false)
  pedidoGrupoId   String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  producto    Producto     @relation(fields: [productoId], references: [id])
  pedidoGrupo PedidoGrupo? @relation(fields: [pedidoGrupoId], references: [id])
}

// Agrupa varias lineas de Pedido cuando un mismo pedido tiene varios
// productos. La sena, el saldo y el estado de pago son del pedido
// completo (no tiene sentido repartirlos por linea); el estado de
// entrega si queda por linea, porque puede entregarse un producto
// antes que otro dentro del mismo pedido.
model PedidoGrupo {
  id            String     @id @default(cuid())
  fecha         DateTime
  periodo       String
  cliente       String
  metodoPago    MetodoPago
  precioTotal   Int
  sena          Int        @default(0)
  saldoRestante Int
  estadoPago    EstadoPago @default(PENDIENTE)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  lineas Pedido[]
}

// Foto del pedido justo antes de borrarlo (sin relacion a Producto/Pedido:
// tiene que sobrevivir aunque el producto se borre despues).
model PedidoEliminado {
  id               String       @id @default(cuid())
  pedidoIdOriginal String
  fecha            DateTime
  periodo          String
  cliente          String
  temporada        Temporada
  genero           Genero
  productoNombre   String
  talle            String
  cantidad         Int
  costoUnitario    Int
  costoTotal       Int
  metodoPago       MetodoPago
  precioUnitario   Int
  precioTotal      Int
  ganancia         Int
  sena             Int
  saldoRestante    Int
  estadoPedido     EstadoPedido
  estadoPago       EstadoPago
  stockDescontado  Boolean
  eliminadoEn      DateTime     @default(now())
}

model HistorialPrecios {
  id             String    @id @default(cuid())
  fecha          DateTime  @default(now())
  productoId     String
  temporada      Temporada
  genero         Genero
  productoNombre String
  talle          String
  costoAnterior  Int
  costoNuevo     Int
  precioAnterior Int
  precioNuevo    Int
  motivo         String

  producto Producto @relation(fields: [productoId], references: [id])
}

// ── Torneo (seccion separada, sin relacion con el modelo de indumentaria) ──

model GrupoEdad {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())

  horarios          Horario[]
  turnosEntrega     TurnoEntrega[]
  plantillaHorarios PlantillaHorario[]
}

model Torneo {
  id                  String       @id @default(cuid())
  mes                 Int
  anio                Int
  estado              EstadoTorneo @default(PLANIFICADO)
  precioEfectivo      Int          @default(18000)
  precioTransferencia Int          @default(22000)
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  horarios Horario[]
  gastos   GastoTorneo[]

  @@unique([mes, anio])
}

model GastoTorneo {
  id        String   @id @default(cuid())
  torneoId  String
  concepto  String
  monto     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  torneo Torneo @relation(fields: [torneoId], references: [id])
}

model Horario {
  id          String   @id @default(cuid())
  torneoId    String
  grupoEdadId String
  hora        String
  cupoMaximo  Int?
  orden       Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  torneo        Torneo              @relation(fields: [torneoId], references: [id])
  grupoEdad     GrupoEdad           @relation(fields: [grupoEdadId], references: [id])
  inscripciones InscripcionTorneo[]
}

enum EstadoTorneo {
  PLANIFICADO
  EN_CURSO
  FINALIZADO
}

model InscripcionTorneo {
  id               String            @id @default(cuid())
  nombre           String
  edad             String?
  horarioId        String
  pago             Boolean           @default(false)
  metodoPago       MetodoPagoTorneo?
  monto            Int?
  equipo           EquipoTorneo?
  equipoAsignadoAt DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  horario Horario @relation(fields: [horarioId], references: [id])
}

enum MetodoPagoTorneo {
  EFECTIVO
  TRANSFERENCIA
}

enum EquipoTorneo {
  ROJO
  AMARILLO
  NARANJA
}

enum Temporada {
  VERANO
  INVIERNO
}

enum Genero {
  MASCULINO
  FEMENINO
}

enum TipoMovimiento {
  INGRESO
  EGRESO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
}

enum EstadoPedido {
  POR_PEDIR
  ENCARGADO
  ENTREGADO
}

enum EstadoPago {
  PENDIENTE
  SENA
  PAGO
}

// ── Configuracion general de la app (fila unica, id "singleton") ──

model Configuracion {
  id                 String   @id @default("singleton")
  indumentariaActiva Boolean  @default(true)
  torneoActivo       Boolean  @default(true)
  premiosActivo      Boolean  @default(false)

  // Precios por defecto al crear un torneo o una entrega nueva.
  precioTorneoEfectivo      Int @default(18000)
  precioTorneoTransferencia Int @default(22000)
  bonoPrecioTransferencia   Int @default(48000)
  bonoDescuentoEfectivoPct  Int @default(15)

  updatedAt DateTime @updatedAt
}

// ── Entrega de premios (evento anual, la familia es la unidad de cobro) ──

model EntregaPremios {
  id                  String   @id @default(cuid())
  anio                Int      @unique
  precioTransferencia Int      @default(48000)
  precioEfectivo      Int      @default(40000)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  turnos TurnoEntrega[]
  gastos GastoEntrega[]
}

model TurnoEntrega {
  id          String   @id @default(cuid())
  entregaId   String
  hora        String
  grupoEdadId String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  entrega   EntregaPremios   @relation(fields: [entregaId], references: [id])
  grupoEdad GrupoEdad?       @relation(fields: [grupoEdadId], references: [id])
  familias  FamiliaEntrega[]
}

// Una familia va completa a un turno y paga un solo bono, sin importar
// cuantos chicos tenga. metodoPago null = todavia no pago; monto es lo que
// corresponde cobrar (editable).
model FamiliaEntrega {
  id            String            @id @default(cuid())
  turnoId       String
  nombre        String
  metodoPago    MetodoPagoTorneo?
  monto         Int
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  turno  TurnoEntrega   @relation(fields: [turnoId], references: [id])
  chicos ChicoEntrega[]
}

model ChicoEntrega {
  id        String   @id @default(cuid())
  familiaId String
  nombre    String
  genero    Genero
  createdAt DateTime @default(now())

  familia FamiliaEntrega @relation(fields: [familiaId], references: [id], onDelete: Cascade)
}

model GastoEntrega {
  id        String   @id @default(cuid())
  entregaId String
  concepto  String
  monto     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entrega EntregaPremios @relation(fields: [entregaId], references: [id])
}

enum SeccionPlantilla {
  TORNEO
  PREMIOS
}

// Horarios que se crean solos al armar un torneo o una entrega nueva.
model PlantillaHorario {
  id          String           @id @default(cuid())
  seccion     SeccionPlantilla
  hora        String
  grupoEdadId String?
  createdAt   DateTime         @default(now())

  grupoEdad GrupoEdad? @relation(fields: [grupoEdadId], references: [id])
}
